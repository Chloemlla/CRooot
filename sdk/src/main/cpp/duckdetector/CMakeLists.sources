file(GLOB_RECURSE CROOOT_DUCK_SOURCES CONFIGURE_DEPENDS
    "${CROOOT_DUCK_ROOT}/*.cpp"
)

if(ANDROID_ABI STREQUAL "arm64-v8a")
    list(APPEND CROOOT_DUCK_SOURCES
        "${CROOOT_DUCK_ROOT}/asm/arm64/syscall_fastpath.S"
        "${CROOOT_DUCK_ROOT}/asm/arm64/tee_timer_arm64.S"
        "${CROOOT_DUCK_ROOT}/asm/arm64/virtualization_traps.S"
    )
elseif(ANDROID_ABI STREQUAL "armeabi-v7a")
    list(APPEND CROOOT_DUCK_SOURCES "${CROOOT_DUCK_ROOT}/asm/arm/syscall_fastpath.S")
elseif(ANDROID_ABI STREQUAL "x86")
    list(APPEND CROOOT_DUCK_SOURCES "${CROOOT_DUCK_ROOT}/asm/x86/syscall_fastpath.S")
elseif(ANDROID_ABI STREQUAL "x86_64")
    list(APPEND CROOOT_DUCK_SOURCES "${CROOOT_DUCK_ROOT}/asm/x86_64/syscall_fastpath.S")
endif()
